{
  "manifest_version": 3,
  "name": "Kadran AI - Yoldaş Aktarım",
  "version": "1.0.0",
  "description": "Kadran AI Studio tasarım kodunu Yoldaş Kadran Atölyesi'ne aktarır.",
  "content_scripts": [
    {
      "matches": ["https://yoldas.io/kadran-atolyesi*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://yoldas.io/*"]
}